    "supabase:test:db": "supabase test db --local",
    "supabase:types": "supabase gen types --lang typescript --local --schema public > types/database.generated.ts",
    "supabase:migration:new": "supabase migration new",
    "supabase:migration:list": "supabase migration list",
    "supabase:db:pull:linked": "supabase db pull --linked",
    "supabase:db:push:linked": "supabase db push --linked",
    "supabase:types:linked": "supabase gen types --lang typescript --linked --schema public > types/database.generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
